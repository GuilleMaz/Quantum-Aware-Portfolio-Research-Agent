    {
      "name": "add_gate_tool",
      "title": "Add Gate Tool",
      "description": "Add a quantum gate to a circuit.\n\nThis tool maintains circuit state between calls. Pass the circuit returned by\nprevious calls to append new gates. If no circuit is provided, a new 8-qubit\ncircuit with 8 classical bits is created automatically.",
      "input_schema": {
        "properties": {
          "circuit": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Dictionary representation of the quantum circuit. If None, creates\na new circuit with 8 qubits and 8 classical bits."
          },
          "gate_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Name of the gate to add (e.g., 'h', 'x', 'cx', 'rz', 'u')."
          },
          "qubits": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "List of qubit indices to apply the gate to. Can be a single qubit\n(e.g., [0]) or multiple qubits (e.g., [0, 1, 2, 3]). When multiple qubits\nare specified for a single-qubit gate, the gate is applied to each qubit."
          },
          "params": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional list of parameters for parameterized gates."
          }
        },
        "type": "object",
        "additionalProperties": false
      },
      "execution": null,
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "icons": null,
