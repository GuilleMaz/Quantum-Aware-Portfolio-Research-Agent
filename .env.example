# ===========================================================================
# EJEMPLO de variables de entorno — COPIAR A .env Y RELLENAR
#
#     Copy-Item .env.example .env
#
# .env ESTA EN .gitignore. NUNCA se commitea.
# Este fichero SI se versiona, y solo con valores vacíos.
# ===========================================================================

# ---------------------------------------------------------------------------
# financial-mcp-server
# ---------------------------------------------------------------------------
# Opcional. Sin ella solo se pierden 4 tools de macro (get_economic_indicator,
# search_fred_series, get_yield_curve, get_economic_snapshot). NO afecta a
# precios, fundamentales, momentum ni paper trading.
# Gratis: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Opcional. Cambia la ubicacion del SQLite de paper trading.
# Default: ~/.financial-mcp/financial_mcp.db
# FINANCIAL_MCP_DB_PATH=

# Opcional. Default: stdio (que es lo que necesitan los clientes de escritorio).
# FINANCIAL_MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# mcp-qiskit
# ---------------------------------------------------------------------------
# Opcional e INUTIL hoy. El simulador Aer (default) funciona sin token.
# Los backends reales de IBM Quantum no son alcanzables desde mcp-qiskit
# (bug verificado: declara qiskit-ibm-runtime pero importa qiskit_ibm_provider).
IBM_QUANTUM_TOKEN=

# ---------------------------------------------------------------------------
# mcp-memory-service (Fase 4)
# ---------------------------------------------------------------------------
# Self-hosted, sin cloud. Con anonymous access no hace falta nada mas.
MCP_ALLOW_ANONYMOUS_ACCESS=true

# ---------------------------------------------------------------------------
# Alternativa cloud (NO verificada la sintaxis del header de auth)
# Requerida si usas https://mcp.mem0.ai/mcp con type: "remote".
# ---------------------------------------------------------------------------
# MEM0_API_KEY=
# MEM0_DEFAULT_USER_ID=quantum-aware-portfolio

# ---------------------------------------------------------------------------
# Proveedores de LLM (para cuando el orquestador use un modelo real)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Encoding de la consola de Windows en PowerShell
#
# mcp-qiskit dibuja circuitos con caracteres de caja Unicode. Sin esto,
# draw_circuit_tool("ascii") rompe con un error de cp1252.
#
# En PowerShell, ANTES de usar el servidor:
#     $env:PYTHONIOENCODING = "utf-8"
#
# Descomentar si lo prefieres global en tu perfil de PowerShell.
# ---------------------------------------------------------------------------
# PYTHONIOENCODING=utf-8

# ---------------------------------------------------------------------------
# NOTAS SOBRE PINNING DE mcp
#
# financial-mcp-server y mem0-mcp-server declaran mcp[cli]>=1.0.0 SIN cota
# superior. uv instala mcp 2.x, donde FastMCP fue renombrado a MCPServer y
# mcp.server.fastmcp ya no existe. El pin va en el COMANDO de arranque
# (--with "mcp<2"), no aqui — porque uvx crea un entorno aislado por servidor.
# Ver config/clients/README.md.
# ---------------------------------------------------------------------------